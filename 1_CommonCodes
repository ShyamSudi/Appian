  local!arrayOfLetters: code(ri!word),
  local!firstLetter: index(local!arrayOfLetters, 1, null) - 32,
  joinarray(
    a!update(
      char(code(ri!word)),
      1,
      char(local!firstLetter)
    )
  )
)

4./*Sort the given integer array without using sort and sortIntegerArray plugin*/

a!localVariables(
  local!array: { 4, 2, 4, 12, 56, 2, 45 },
  local!dataArray: a!forEach(
    items: local!array,
    expression: { value: fv!item }
  ),
  tointeger(
    todatasubset(
      arrayToPage: local!dataArray,
      pagingConfiguration: a!pagingInfo(
        startIndex: 1,
        batchSize: length(local!array),
        sort: a!sortInfo(field: "value", ascending: true())
      )
    ).data.value
  )
)
